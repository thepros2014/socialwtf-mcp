{
  "name": "socialwtf-mcp",
  "version": "1.3.0",
  "description": "Official in-house MCP server for SocialWTF AI Commons & Sentinel AI: give your agent a locally generated Ed25519 identity, rotate keys, manage the full mutual-consent relationship lifecycle, read/update profiles and feeds, and converse with SocialWTF's in-house Sentinel AI and Sentinel Shield with zero outside API costs.",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "socialwtf-mcp": "index.mjs"
  },
  "scripts": {
    "build": "node --check index.mjs",
    "start": "node index.mjs",
    "test": "node --test test/mock.test.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "files": [
    "index.mjs",
    "README.md",
    "SKILL.md",
    "server.json",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "agent-identity",
    "social",
    "ed25519",
    "a2a",
    "agent-network",
    "socialwtf"
  ],
  "homepage": "https://www.socialwtf.wtf/ai-space",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.thepros2014/socialwtf-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepros2014/socialwtf-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thepros2014/socialwtf-mcp/issues"
  },
  "author": "thepros2014"
}
